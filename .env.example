# -----------------------------
# Core AI Providers
# -----------------------------
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LIBLIBAI_BASE_URL=https://openapi.liblibai.cloud
LIBLIBAI_ACCESS_KEY=your-liblib-access-key
LIBLIBAI_SECRET_KEY=your-liblib-secret-key
LIBLIBAI_URI=/api/generate/webui/text2img
LIBLIBAI_STATUS_URI=/api/generate/webui/status
LIBLIBAI_TEMPLATE_UUID=6f7c4652458d4802969f8d089cf5b91f
LIBLIBAI_TIMEOUT_SEC=120
LIBLIBAI_WIDTH=768
LIBLIBAI_HEIGHT=768
LIBLIBAI_STEPS=25

# -----------------------------
# Database (MySQL recommended)
# -----------------------------
# Primary write DB
DATABASE_URL=mysql+aiomysql://inkai_user:StrongPassword@127.0.0.1:3306/inkai?charset=utf8mb4
# Optional read replica DB (fallback to DATABASE_URL if empty)
DATABASE_READ_URL=mysql+aiomysql://inkai_read:StrongPassword@127.0.0.1:3306/inkai?charset=utf8mb4
# SQLAlchemy async pool tuning
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=16
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------
# Redis / Cache / Queue
# -----------------------------
# master switch (compatible with legacy REDIS_CACHE_ENABLED)
REDIS_ENABLED=true
# optional host/port style config (used when REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_SEC=3

GENERATION_QUEUE_ENABLED=true
GENERATION_QUEUE_MAX_RETRY=2
GENERATION_QUEUE_WAIT_TIMEOUT_SEC=140
GENERATION_QUEUE_POLL_INTERVAL_MS=800
REDIS_STREAM_GEN_KEY=inkai:stream:gen
REDIS_STREAM_GEN_DLQ_KEY=inkai:stream:gen:dlq
REDIS_STREAM_GROUP=inkai-gen-workers
REDIS_STREAM_CONSUMER_PREFIX=worker

# Admin dashboard/export runtime
ADMIN_STATS_CACHE_TTL_SEC=45
EXPORT_QUEUE_ENABLED=true
EXPORT_QUEUE_WAIT_TIMEOUT_SEC=300
REDIS_STREAM_EXPORT_KEY=inkai:stream:export
REDIS_STREAM_EXPORT_DLQ_KEY=inkai:stream:export:dlq
REDIS_STREAM_EXPORT_GROUP=inkai-export-workers
REDIS_STREAM_EXPORT_CONSUMER_PREFIX=export-worker
ADMIN_EXPORT_DIR=./tmp_exports
ADMIN_EXPORT_RETENTION_HOURS=24

# -----------------------------
# Runtime limits and sync jobs
# -----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=180
RATE_LIMIT_IP_WINDOW_SEC=60
RATE_LIMIT_USER_LIMIT=240
RATE_LIMIT_USER_WINDOW_SEC=60

COUNTER_SYNC_ENABLED=true
COUNTER_SYNC_HOURLY_CRON_MINUTE=5
COUNTER_SYNC_DAILY_CRON_HOUR=1
COUNTER_SYNC_DAILY_CRON_MINUTE=10

# -----------------------------
# Content safety provider (optional)
# provider: off / aliyun / tencent
# -----------------------------
CONTENT_SAFETY_PROVIDER=off
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_ACCESS_KEY=
CONTENT_SAFETY_SECRET_KEY=
CONTENT_SAFETY_TIMEOUT_SEC=10

# -----------------------------
# JWT / Auth
# -----------------------------
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=14
AUTH_DEBUG_RETURN_SMS_CODE=true
ROOT_USERNAME=admin
ROOT_PASSWORD=change-this-password

# -----------------------------
# SuperTokens (optional)
# -----------------------------
SUPERTOKENS_ENABLED=false
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
# SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=Ink-Aesthetics AI
SUPERTOKENS_API_DOMAIN=http://127.0.0.1:8787
SUPERTOKENS_WEBSITE_DOMAIN=http://127.0.0.1:5173
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
SUPERTOKENS_TENANT_ID=public

# -----------------------------
# Prompt safety & billing credits
# -----------------------------
PROMPT_GUARD_ENABLED=true
# PROMPT_GUARD_BLOCK_TERMS=
BILLING_COST_PROMPT_OPTIMIZE=0
BILLING_COST_LIBLIBAI_GEN_IMG=60
BILLING_COST_DEEPSEEK_CHAT=0

# -----------------------------
# App basics
# -----------------------------
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEMO_USER_ID=demo-user
BACKEND_ADMIN_TOKEN=

# -----------------------------
# SMTP mail
# -----------------------------
SMTP_FROM=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_SERVER=smtp.example.com
SMTP_PORT=465

# -----------------------------
# Cloudflare Turnstile
# -----------------------------
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_ENABLED=true
TURNSTILE_FAIL_OPEN=false
TURNSTILE_ALLOW_LOCAL_BYPASS=false
TURNSTILE_SECRET_KEY=replace-with-secret-key
